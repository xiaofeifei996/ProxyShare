#!/bin/bash
# 卸载前：停守护进程、清理
set -e

DAEMON=/Library/LaunchDaemons/com.axs.proxyshare.plist
launchctl bootout system "$DAEMON" 2>/dev/null || true
launchctl unload -w "$DAEMON" 2>/dev/null || true

# 软链接（保留用户数据，只删链接）
rm -f /var/mobile/Library/ProxyShare 2>/dev/null || true

echo "[ProxyShare] 已停止（配置与日志保留在 /var/tmp/ProxyShare）"
exit 0
