#!/bin/bash
# 卸载前：停守护进程
#
# 同 postrm：dpkg 覆盖安装时也会调用本脚本并传 "upgrade <old> <new>"。
# 升级时**不要删 LaunchDaemon**，否则新版本启动不了。

ACTION="$1"

case "$ACTION" in
    upgrade|failed-upgrade|disappear)
        echo "[ProxyShare] 升级中，仅停止服务"
        launchctl bootout system /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null
        killall -9 psd 2>/dev/null
        exit 0
        ;;
esac

# 真正卸载
launchctl bootout system /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null
launchctl unload -w /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null
killall -9 psd 2>/dev/null

rm -f /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null

echo "[ProxyShare] 已停止"
exit 0
