#!/bin/bash
# 卸载前：停止守护进程
#
# 重要：实测 RootHide 下 dpkg 调用本脚本时**不传参数**（$1 为空），
# 所以不能用 $1 区分 upgrade / remove。
# 用 DPKG_MAINTSCRIPT_PACKAGE + 文件存在性判断不可靠，
# 因此这里的策略是：**只停服务，绝不删任何文件**。
# 删除交给 postrm（它同样只做必要清理）。

DAEMON=/Library/LaunchDaemons/com.axs.proxyshare.plist

launchctl bootout system "$DAEMON" 2>/dev/null
killall -9 psd 2>/dev/null

echo "[ProxyShare] 服务已停止"
exit 0
