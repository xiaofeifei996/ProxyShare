<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>

		<!-- ================= 当前配置 ================= -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>当前配置</string>
			<key>footerText</key><string>配置保存在 LaunchDaemon 的启动参数里。受 RootHide 沙盒限制，此处只做展示，修改请用下方的命令。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSTitleValueCell</string>
			<key>label</key><string>状态</string>
			<key>get</key><string>enabledValue:</string>
		</dict>
		<dict>
			<key>cell</key><string>PSTitleValueCell</string>
			<key>label</key><string>本机地址</string>
			<key>get</key><string>ipValue:</string>
		</dict>
		<dict>
			<key>cell</key><string>PSTitleValueCell</string>
			<key>label</key><string>SOCKS5 端口</string>
			<key>get</key><string>socksValue:</string>
		</dict>
		<dict>
			<key>cell</key><string>PSTitleValueCell</string>
			<key>label</key><string>HTTP 端口</string>
			<key>get</key><string>httpValue:</string>
		</dict>
		<dict>
			<key>cell</key><string>PSTitleValueCell</string>
			<key>label</key><string>绑定地址</string>
			<key>get</key><string>bindValue:</string>
		</dict>

		<!-- ================= 复制地址 ================= -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>复制给别人用</string>
			<key>footerText</key><string>点一下即可复制，粘贴到对方设备的代理设置里。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>SOCKS5 地址</string>
			<key>get</key><string>socksAddr:</string>
			<key>action</key><string>copySocks:</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>HTTP 地址</string>
			<key>get</key><string>httpAddr:</string>
			<key>action</key><string>copyHTTP:</string>
		</dict>

		<!-- ================= 修改配置 ================= -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>修改配置</string>
			<key>footerText</key><string>打开终端（NewTerm / SSH）执行下面的命令，需要 root。\n\n改 SOCKS5 端口：\n  sudo psctl set socks 47690\n  sudo psctl restart\n\n改 HTTP 端口：\n  sudo psctl set http 47691\n  sudo psctl restart\n\n临时关闭：\n  sudo psctl off\n\n查看状态：\n  sudo psctl status</string>
		</dict>

		<!-- ================= 用法 ================= -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>怎么用</string>
			<key>footerText</key><string>iOS 设备：Wi-Fi → 当前网络 → 配置代理 → 手动 → 填上面的「HTTP 地址」。\n\nAndroid / Clash：加 SOCKS5 节点，填「SOCKS5 地址」。\n\n前提：\n· 本机的代理软件（Shadowrocket 等）要保持运行\n· 两台设备在同一个 Wi-Fi 下\n· 出口 IP 与本机一致，即为你代理的出口</string>
		</dict>

	</array>
</dict>
</plist>
