<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 脱离 App 沙盒 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- 访问各类存储 -->
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.storage.MobileDocuments</key>
	<true/>
	<key>com.apple.private.security.storage.Photos</key>
	<true/>

	<!-- 关键：允许访问沙盒外文件系统（越狱工具常用） -->
	<key>com.apple.private.security.storage.ExcludedFromBackup</key>
	<true/>
	<key>com.apple.private.security.storage.MediaLibrary</key>
	<true/>

	<!-- 网络 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- 允许作为守护进程运行 -->
	<key>com.apple.private.launchd.allow-unauthorized-kexts</key>
	<true/>
	<key>com.apple.private.launchd.allowanyexec</key>
	<true/>
	<key>com.apple.private.cs.debugger</key>
	<true/>
</dict>
</plist>
