#!/bin/bash
# 卸载前：停守护进程
# 注意：不要用 set -e，卸载过程任何一步失败都不应中断，
# 否则 dpkg 会留下半卸载状态（文件在、dpkg 记录也还在）。

DAEMON=/Library/LaunchDaemons/com.axs.proxyshare.plist

launchctl bootout system "$DAEMON" 2>/dev/null || true
launchctl unload -w "$DAEMON" 2>/dev/null || true

# 保险：直接杀进程
killall -9 psd 2>/dev/null || true

rm -f "$DAEMON" 2>/dev/null || true

echo "[ProxyShare] 已停止"
exit 0
