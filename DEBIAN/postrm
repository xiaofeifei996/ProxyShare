#!/bin/bash
# 卸载后：清理残留
#
# 关键：dpkg 覆盖安装（upgrade）时也会调用本脚本，参数是 "upgrade <old-version>"。
# 此时**绝不能删文件**，否则会把自己刚解包的内容删掉
# （这就是之前「装完 psd 不见了」的原因）。
#
# 参数约定：
#   remove    <old-version> [<new-version>]   卸载
#   purge     <old-version> [<new-version>]   彻底卸载
#   upgrade   <old-version> <new-version>     升级
#   disappear <overwriter> <version>          被别的包覆盖
#   failed-upgrade <old-version>              升级失败

ACTION="$1"

case "$ACTION" in
    upgrade|failed-upgrade|disappear)
        echo "[ProxyShare] 升级中，保留文件"
        exit 0
        ;;
esac

# 以下是真正的卸载（remove / purge），才做清理
echo "[ProxyShare] 正在卸载..."

launchctl bootout system /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null
killall -9 psd 2>/dev/null

# 二进制（dpkg 一般会自己删，这里兜底）
rm -f /usr/bin/psctl            2>/dev/null
rm -f /usr/libexec/psd          2>/dev/null
rm -f /usr/libexec/psd-launcher 2>/dev/null

# LaunchDaemon
rm -f /Library/LaunchDaemons/com.axs.proxyshare.plist 2>/dev/null

# 设置面板（两种目录名都清）
rm -rf /Library/PreferenceBundles/ProxySharePrefs.bundle 2>/dev/null
rm -rf /Library/PreferenceBundles/ProxySharePrefs 2>/dev/null
rm -f  /Library/PreferenceLoader/Preferences/ProxyShare.plist 2>/dev/null

# purge 时连数据一起清
if [ "$ACTION" = "purge" ]; then
    rm -rf /var/tmp/ProxyShare 2>/dev/null
    rm -f  /var/mobile/Library/ProxyShare 2>/dev/null
    echo "[ProxyShare] 已彻底清除（含配置）"
else
    echo "[ProxyShare] 已卸载（配置保留在 /var/tmp/ProxyShare）"
fi

exit 0
