#!/bin/bash
# 卸载后清理
#
# 关键教训：RootHide 下 dpkg 调用时**不传参数**（$1 为空），
# 无法用 $1 区分 upgrade / remove。
#
# 因此改用「反查」判断：如果包的文件清单还存在于 dpkg 数据库里、
# 且主程序文件存在，说明这是一次覆盖安装 → 什么都不删。
# 只有确认文件已被 dpkg 移除，才做残留清理。

PSD=/usr/libexec/psd
PSCTL=/usr/bin/psctl
DAEMON=/Library/LaunchDaemons/com.axs.proxyshare.plist

# 覆盖安装：dpkg 刚解包完，文件都在 → 不能删
if [ -f "$PSD" ] && [ -f "$DAEMON" ]; then
    echo "[ProxyShare] 检测到升级安装，保留文件"
    # 只重启服务让新二进制生效
    launchctl bootout system "$DAEMON" 2>/dev/null
    sleep 1
    launchctl bootstrap system "$DAEMON" 2>/dev/null \
        || launchctl load -w "$DAEMON" 2>/dev/null
    exit 0
fi

# 真正卸载：主程序已不在 → 清理残留
echo "[ProxyShare] 正在清理残留..."
launchctl bootout system "$DAEMON" 2>/dev/null
killall -9 psd 2>/dev/null

rm -f "$PSCTL"                    2>/dev/null
rm -f "$PSD"                      2>/dev/null
rm -f /usr/libexec/psd-launcher   2>/dev/null
rm -f "$DAEMON"                   2>/dev/null
rm -rf /Library/PreferenceBundles/ProxySharePrefs.bundle 2>/dev/null
rm -rf /Library/PreferenceBundles/ProxySharePrefs 2>/dev/null
rm -f /Library/PreferenceLoader/Preferences/ProxyShare.plist 2>/dev/null

echo "[ProxyShare] 已卸载（配置保留在 /var/tmp/ProxyShare）"
exit 0
